<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#102b24" />
  <meta name="description" content="Thoughtfully designed interiors for flats and individual homes across Andhra Pradesh and Telangana. Plan your home with Sannidhi Interiors." />
  <meta property="og:title" content="Sannidhi Interiors — Homes made personal" />
  <meta property="og:description" content="Beautiful, practical interiors for the way your family lives." />
  <meta property="og:type" content="website" />
  <title>Sannidhi Interiors | Thoughtful Homes, Beautifully Made</title>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preconnect" href="https://images.unsplash.com" />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet" />

  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            forest: { 950: '#0b1d18', 900: '#102b24', 800: '#173b31', 700: '#245344' },
            sage: { 100: '#e9eee8', 200: '#d7e1d7', 300: '#b9caba' },
            brass: { 300: '#d9c18e', 400: '#c9ad70' },
            paper: '#f7f6f1', ink: '#18251f'
          },
          fontFamily: {
            sans: ['DM Sans', 'Manrope', 'sans-serif'],
            display: ['Playfair Display', 'Georgia', 'serif'],
            heading: ['Manrope', 'sans-serif']
          },
          boxShadow: {
            soft: '0 18px 55px rgba(15, 34, 27, .10)',
            float: '0 20px 70px rgba(7, 24, 18, .24)'
          }
        }
      }
    };
  </script>
  <style>
    :root { color-scheme: light; }
    html { scroll-behavior: smooth; scroll-padding-top: 6.5rem; }
    body { background: #f7f6f1; color: #18251f; }
    ::selection { background: #c9ad70; color: #102b24; }
    .glass-nav { background: rgba(247, 246, 241, .84); border: 1px solid rgba(255,255,255,.68); box-shadow: 0 10px 35px rgba(7,24,18,.10); backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px); }
    .hero-bg {
      background-image:
        linear-gradient(90deg, rgba(7, 25, 19, .82) 0%, rgba(7, 25, 19, .57) 43%, rgba(7, 25, 19, .13) 100%),
        linear-gradient(0deg, rgba(7, 25, 19, .42), transparent 48%),
        url('https://images.unsplash.com/photo-1600210492486-724fe5c67fb0?auto=format&fit=crop&w=2400&q=90');
      background-position: center, center, center 55%;
      background-size: cover;
    }
    .eyebrow { letter-spacing: .22em; }
    .service-card { transition: transform .35s ease, box-shadow .35s ease, border-color .35s ease; }
    .service-card:hover { transform: translateY(-6px); box-shadow: 0 22px 55px rgba(16,43,36,.11); border-color: #c9ad70; }
    .image-frame { position: relative; overflow: hidden; }
    .image-frame::after { content: ''; position: absolute; inset: 0; border: 1px solid rgba(255,255,255,.2); pointer-events: none; }
    .form-control { width: 100%; border: 1px solid #d7ded7; border-radius: .7rem; background: #fff; padding: .9rem 1rem; color: #18251f; outline: none; transition: border-color .2s, box-shadow .2s; }
    .form-control:focus { border-color: #245344; box-shadow: 0 0 0 4px rgba(36,83,68,.12); }
    .form-control::placeholder { color: #87928b; }
    .form-control:invalid:not(:placeholder-shown) { border-color: #b45353; }
    .form-label { display: block; margin-bottom: .48rem; color: #24372e; font-size: .88rem; font-weight: 600; }
    .social-link { display: grid; place-items: center; width: 2.65rem; height: 2.65rem; border-radius: 999px; border: 1px solid rgba(255,255,255,.22); color: #f7f6f1; transition: background .2s, color .2s, transform .2s; }
    .social-link:hover { background: #d9c18e; color: #102b24; transform: translateY(-2px); }
    .skip-link { position: absolute; top: -5rem; left: 1rem; z-index: 100; padding: .75rem 1rem; background: #fff; color: #102b24; border-radius: .5rem; }
    .skip-link:focus { top: 1rem; }
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { scroll-behavior: auto !important; animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; }
    }
  </style>
</head>
<body class="font-sans antialiased">
  <a class="skip-link" href="#main-content">Skip to content</a>

  <!-- Floating glass navigation -->
  <header class="fixed inset-x-0 top-0 z-50 px-3 pt-3 sm:px-6 sm:pt-5">
    <nav class="glass-nav mx-auto flex max-w-7xl items-center justify-between rounded-2xl px-4 py-3 sm:px-6" aria-label="Main navigation">
      <a href="#home" class="flex items-center gap-3" aria-label="Sannidhi Interiors home">
        <span class="grid h-10 w-10 place-items-center rounded-xl bg-forest-900 font-display text-2xl text-brass-300">S</span>
        <span class="leading-tight">
          <span class="block font-heading text-[1.02rem] font-extrabold tracking-[.12em] text-forest-900">SANNIDHI</span>
          <span class="block text-[.62rem] font-semibold tracking-[.28em] text-forest-700">INTERIORS</span>
        </span>
      </a>

      <div class="hidden items-center gap-8 md:flex">
        <a class="text-sm font-semibold text-ink/75 transition hover:text-forest-900" href="#services">Services</a>
        <a class="text-sm font-semibold text-ink/75 transition hover:text-forest-900" href="#approach">Our approach</a>
        <a class="text-sm font-semibold text-ink/75 transition hover:text-forest-900" href="#contact">Contact</a>
        <a href="#contact" class="rounded-full bg-forest-900 px-5 py-3 text-sm font-bold text-white transition hover:bg-forest-700 focus:outline-none focus:ring-4 focus:ring-forest-900/20">Book Consultation <span aria-hidden="true">↗</span></a>
      </div>

      <button id="menu-toggle" class="grid h-11 w-11 place-items-center rounded-xl border border-forest-900/10 text-forest-900 md:hidden" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Open navigation menu">
        <svg id="menu-open-icon" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7"><path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16" /></svg>
        <svg id="menu-close-icon" xmlns="http://www.w3.org/2000/svg" class="hidden h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7"><path stroke-linecap="round" d="m6 6 12 12M18 6 6 18" /></svg>
      </button>
    </nav>
    <div id="mobile-menu" class="glass-nav mx-auto mt-2 hidden max-w-7xl rounded-2xl p-4 md:hidden">
      <div class="flex flex-col gap-1">
        <a class="rounded-xl px-4 py-3 text-sm font-semibold text-forest-900 hover:bg-sage-100" href="#services">Services</a>
        <a clas